QR


package ar.edu.festivalcine.modelo.entrada;

import ar.edu.festivalcine.excepciones.EntradaInvalidaException;
import ar.edu.festivalcine.modelo.persona.Espectador;
import ar.edu.festivalcine.modelo.sala.Butaca;
import ar.edu.festivalcine.modelo.sala.Funcion;

import java.time.LocalDateTime;

/**
 * Entrada digital con código QR.
 * Se valida mediante el escaneo del QR en puerta y registra la fecha y hora
 * exactas del escaneo para fines de auditoría.
 */
public class EntradaQR extends Entrada {

    // ============================
    // ATRIBUTOS PROPIOS
    // ============================
    private String urlValidacion;     // URL única para escanear el QR
    private LocalDateTime fechaEscaneo;

    // ============================
    // CONSTRUCTOR
    // ============================
    public EntradaQR(String codigo, double precio,
                     Espectador espectador, Funcion funcion, Butaca butaca,
                     String urlValidacion) {
        super(codigo, precio, espectador, funcion, butaca);
        this.urlValidacion = urlValidacion;
        this.fechaEscaneo = null;  // se setea al validar
    }

    // ============================
    // IMPLEMENTACIÓN DE MÉTODOS ABSTRACTOS
    // ============================
    /**
     * Genera el comprobante en formato digital con el QR embebido.
     */
    @Override
    public String generarComprobante() {
        return String.format(
                "===== ENTRADA DIGITAL =====%n" +
                "Código QR: %s%n" +
                "Película: %s%n" +
                "Sala: %s%n" +
                "Fecha: %s%n" +
                "Butaca: %s%n" +
                "URL Validación: %s%n" +
                "Precio: $%.2f%n" +
                "===========================",
                codigo,
                funcion.getPelicula().getTitulo(),
                funcion.getSala().getNombre(),
                funcion.getFechaHora(),
                butaca.getCodigo(),
                urlValidacion,
                precio);
    }

    /**
     * Valida la entrada escaneando el QR.
     * Marca la entrada como usada y registra la fecha de escaneo.
     */
    @Override
    public void validar() {
        if (!esVigente()) {
            throw new EntradaInvalidaException(
                    "La entrada QR " + codigo + " corresponde a una función ya pasada.");
        }
        marcarComoUsada();
        this.fechaEscaneo = LocalDateTime.now();
    }

    // ============================
    // GETTERS
    // ============================
    public String getUrlValidacion() { return urlValidacion; }
    public LocalDateTime getFechaEscaneo() { return fechaEscaneo; }
}

