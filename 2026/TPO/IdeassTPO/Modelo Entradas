package ar.edu.festivalcine.modelo.entrada;

import ar.edu.festivalcine.excepciones.DatosInvalidosException;
import ar.edu.festivalcine.excepciones.EntradaInvalidaException;
import ar.edu.festivalcine.modelo.persona.Espectador;
import ar.edu.festivalcine.modelo.sala.Butaca;
import ar.edu.festivalcine.modelo.sala.Funcion;

/**
 * Entrada física impresa.
 * Se identifica por un número de serie único y un color que indica
 * el tipo de función (ej: "azul" para estreno, "rojo" para gala).
 * Se valida mediante el control manual del acomodador en puerta.
 */
public class EntradaFisica extends Entrada {

    // ============================
    // ATRIBUTOS PROPIOS
    // ============================
    private String numeroSerie;
    private String colorTicket;       // ej: "Azul", "Rojo", "Dorado"

    // ============================
    // CONSTRUCTOR
    // ============================
    public EntradaFisica(String codigo, double precio,
                         Espectador espectador, Funcion funcion, Butaca butaca,
                         String numeroSerie, String colorTicket) {
        super(codigo, precio, espectador, funcion, butaca);

        if (numeroSerie == null || numeroSerie.isBlank()) {
            throw new DatosInvalidosException("El número de serie no puede estar vacío.");
        }

        this.numeroSerie = numeroSerie;
        this.colorTicket = colorTicket;
    }

    // ============================
    // IMPLEMENTACIÓN DE MÉTODOS ABSTRACTOS
    // ============================
    /**
     * Genera el comprobante en formato de ticket impreso.
     */
    @Override
    public String generarComprobante() {
        return String.format(
                "===== TICKET FÍSICO =====%n" +
                "Código: %s%n" +
                "N° Serie: %s%n" +
                "Color: %s%n" +
                "Película: %s%n" +
                "Sala: %s%n" +
                "Fecha: %s%n" +
                "Butaca: %s%n" +
                "Precio: $%.2f%n" +
                "=========================",
                codigo,
                numeroSerie,
                colorTicket,
                funcion.getPelicula().getTitulo(),
                funcion.getSala().getNombre(),
                funcion.getFechaHora(),
                butaca.getCodigo(),
                precio);
    }

    /**
     * Valida la entrada mediante el control manual del acomodador.
     * Marca la entrada como usada.
     */
    @Override
    public void validar() {
        if (!esVigente()) {
            throw new EntradaInvalidaException(
                    "La entrada física " + codigo + " corresponde a una función ya pasada.");
        }
        marcarComoUsada();
    }

    // ============================
    // GETTERS
    // ============================
    public String getNumeroSerie() { return numeroSerie; }
    public String getColorTicket() { return colorTicket; }
}



