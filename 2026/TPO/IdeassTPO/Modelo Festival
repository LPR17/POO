package ar.edu.festivalcine.modelo.festival;

import ar.edu.festivalcine.excepciones.DatosInvalidosException;

import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

/**
 * Representa una edición anual del festival de cine.
 * Centraliza las secciones, fechas y datos generales de una edición específica.
 *
 * NOTA: Las relaciones con Funcion, Premio y Sponsor se agregarán
 * cuando definamos esas clases.
 */
public class Edicion {

    // ============================
    // ATRIBUTOS
    // ============================
    private int numero;            // ej: 35 (35° edición del festival)
    private int anio;
    private LocalDate fechaInicio;
    private LocalDate fechaFin;
    private String lema;           // ej: "El cine que nos une"

    // Relaciones
    private List<Seccion> secciones;

    // ============================
    // CONSTRUCTOR
    // ============================
    public Edicion(int numero, int anio, LocalDate fechaInicio, LocalDate fechaFin, String lema) {
        if (numero <= 0) {
            throw new DatosInvalidosException("El número de edición debe ser positivo.");
        }
        if (anio < 1900) {
            throw new DatosInvalidosException("El año de la edición es inválido.");
        }
        if (fechaInicio == null || fechaFin == null) {
            throw new DatosInvalidosException("Las fechas de inicio y fin son obligatorias.");
        }
        if (fechaFin.isBefore(fechaInicio)) {
            throw new DatosInvalidosException("La fecha de fin no puede ser anterior a la de inicio.");
        }

        this.numero = numero;
        this.anio = anio;
        this.fechaInicio = fechaInicio;
        this.fechaFin = fechaFin;
        this.lema = lema;
        this.secciones = new ArrayList<>();
    }

    // ============================
    // MÉTODOS DE NEGOCIO
    // ============================
    /**
     * Agrega una sección a la edición.
     * No permite secciones duplicadas (mismo nombre).
     */
    public void agregarSeccion(Seccion seccion) {
        if (seccion == null) {
            throw new DatosInvalidosException("La sección no puede ser nula.");
        }
        if (secciones.contains(seccion)) {
            throw new DatosInvalidosException(
                    "Ya existe una sección con el nombre '" + seccion.getNombre() + "'.");
        }
        secciones.add(seccion);
    }

    /**
     * Busca una sección por nombre (case-insensitive).
     * Retorna null si no la encuentra.
     */
    public Seccion buscarSeccion(String nombre) {
        for (Seccion s : secciones) {
            if (s.getNombre().equalsIgnoreCase(nombre)) {
                return s;
            }
        }
        return null;
    }

    /**
     * Indica si la edición está actualmente en curso (la fecha de hoy
     * está entre fechaInicio y fechaFin).
     */
    public boolean estaEnCurso() {
        LocalDate hoy = LocalDate.now();
        return !hoy.isBefore(fechaInicio) && !hoy.isAfter(fechaFin);
    }

    /**
     * Devuelve la cantidad total de películas inscriptas en todas las secciones.
     */
    public int getTotalPeliculas() {
        int total = 0;
        for (Seccion s : secciones) {
            total += s.getCantidadPeliculas();
        }
        return total;
    }

    // ============================
    // GETTERS Y SETTERS
    // ============================
    public int getNumero() { return numero; }
    public int getAnio() { return anio; }
    public LocalDate getFechaInicio() { return fechaInicio; }
    public LocalDate getFechaFin() { return fechaFin; }

    public String getLema() { return lema; }
    public void setLema(String lema) { this.lema = lema; }

    /**
     * Devuelve una copia de la lista de secciones para evitar modificaciones externas.
     */
    public List<Seccion> getSecciones() {
        return new ArrayList<>(secciones);
    }

    // ============================
    // EQUALS, HASHCODE Y TOSTRING
    // ============================
    /**
     * Dos ediciones son iguales si tienen el mismo número y año.
     */
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Edicion)) return false;
        Edicion otra = (Edicion) obj;
        return this.numero == otra.numero && this.anio == otra.anio;
    }

    @Override
    public int hashCode() {
        return numero * 31 + anio;
    }

    @Override
    public String toString() {
        return String.format("Edición N° %d (%d) - %d secciones",
                numero, anio, secciones.size());
    }
}

