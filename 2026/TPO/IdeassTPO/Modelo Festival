package ar.edu.festivalcine.modelo.festival;

import ar.edu.festivalcine.excepciones.DatosInvalidosException;

import java.util.ArrayList;
import java.util.List;

/**
 * Representa una sección dentro de una edición del festival.
 * Cada sección agrupa películas que compiten en la misma categoría
 * (ej: "Competencia Oficial", "Documentales", "Cortometrajes").
 */
public class Seccion {

    // ============================
    // ATRIBUTOS
    // ============================
    private String nombre;
    private String descripcion;
    private List<Pelicula> peliculas;

    // ============================
    // CONSTRUCTOR
    // ============================
    public Seccion(String nombre, String descripcion) {
        if (nombre == null || nombre.isBlank()) {
            throw new DatosInvalidosException("El nombre de la sección no puede estar vacío.");
        }

        this.nombre = nombre;
        this.descripcion = descripcion;
        this.peliculas = new ArrayList<>();
    }

    // ============================
    // MÉTODOS DE NEGOCIO
    // ============================
    /**
     * Inscribe una película en la sección.
     * No permite duplicados.
     */
    public void inscribirPelicula(Pelicula pelicula) {
        if (pelicula == null) {
            throw new DatosInvalidosException("La película no puede ser nula.");
        }
        if (!peliculas.contains(pelicula)) {
            peliculas.add(pelicula);
        }
    }

    /**
     * Retira una película de la sección si está inscripta.
     */
    public void quitarPelicula(Pelicula pelicula) {
        peliculas.remove(pelicula);
    }

    /**
     * Indica si la sección contiene la película dada.
     */
    public boolean contienePelicula(Pelicula pelicula) {
        return peliculas.contains(pelicula);
    }

    /**
     * Devuelve la cantidad de películas inscriptas en la sección.
     */
    public int getCantidadPeliculas() {
        return peliculas.size();
    }

    // ============================
    // GETTERS Y SETTERS
    // ============================
    public String getNombre() { return nombre; }

    public String getDescripcion() { return descripcion; }
    public void setDescripcion(String descripcion) { this.descripcion = descripcion; }

    /**
     * Devuelve una copia de la lista de películas para evitar modificaciones externas.
     */
    public List<Pelicula> getPeliculas() {
        return new ArrayList<>(peliculas);
    }

    // ============================
    // EQUALS, HASHCODE Y TOSTRING
    // ============================
    /**
     * Dos secciones son iguales si tienen el mismo nombre.
     */
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Seccion)) return false;
        Seccion otra = (Seccion) obj;
        return this.nombre.equalsIgnoreCase(otra.nombre);
    }

    @Override
    public int hashCode() {
        return nombre.toLowerCase().hashCode();
    }

    @Override
    public String toString() {
        return String.format("Sección '%s' (%d películas)", nombre, peliculas.size());
    }
}

