package ar.edu.festivalcine.modelo.festival;

import ar.edu.festivalcine.enums.Genero;
import ar.edu.festivalcine.excepciones.DatosInvalidosException;
import ar.edu.festivalcine.modelo.persona.Actor;
import ar.edu.festivalcine.modelo.persona.Director;

import java.util.ArrayList;
import java.util.List;

/**
 * Representa una película participante del festival.
 * Una película tiene un director, uno o más actores, y puede estar inscripta
 * en una o más secciones de una edición.
 */
public class Pelicula {

    // ============================
    // ATRIBUTOS
    // ============================
    private String id;
    private String titulo;
    private int duracionMinutos;
    private int anio;
    private Genero genero;
    private String sinopsis;

    // Relaciones
    private Director director;
    private List<Actor> actores;

    // ============================
    // CONSTRUCTOR
    // ============================
    public Pelicula(String id, String titulo, int duracionMinutos, int anio,
                    Genero genero, String sinopsis, Director director) {
        if (id == null || id.isBlank()) {
            throw new DatosInvalidosException("El ID de la película no puede estar vacío.");
        }
        if (titulo == null || titulo.isBlank()) {
            throw new DatosInvalidosException("El título no puede estar vacío.");
        }
        if (duracionMinutos <= 0) {
            throw new DatosInvalidosException("La duración debe ser mayor a 0.");
        }
        if (anio < 1895) {  // año del primer film de la historia
            throw new DatosInvalidosException("El año de la película es inválido.");
        }
        if (genero == null) {
            throw new DatosInvalidosException("El género es obligatorio.");
        }
        if (director == null) {
            throw new DatosInvalidosException("La película debe tener un director.");
        }

        this.id = id;
        this.titulo = titulo;
        this.duracionMinutos = duracionMinutos;
        this.anio = anio;
        this.genero = genero;
        this.sinopsis = sinopsis;
        this.director = director;
        this.actores = new ArrayList<>();
    }

    // ============================
    // MÉTODOS DE NEGOCIO
    // ============================
    /**
     * Agrega un actor al elenco de la película.
     * No permite duplicados.
     */
    public void agregarActor(Actor actor) {
        if (actor == null) {
            throw new DatosInvalidosException("El actor no puede ser nulo.");
        }
        if (!actores.contains(actor)) {
            actores.add(actor);
        }
    }

    /**
     * Quita un actor del elenco si existe.
     */
    public void quitarActor(Actor actor) {
        actores.remove(actor);
    }

    // ============================
    // GETTERS Y SETTERS
    // ============================
    public String getId() { return id; }

    public String getTitulo() { return titulo; }
    public void setTitulo(String titulo) {
        if (titulo == null || titulo.isBlank()) {
            throw new DatosInvalidosException("El título no puede estar vacío.");
        }
        this.titulo = titulo;
    }

    public int getDuracionMinutos() { return duracionMinutos; }
    public int getAnio() { return anio; }
    public Genero getGenero() { return genero; }

    public String getSinopsis() { return sinopsis; }
    public void setSinopsis(String sinopsis) { this.sinopsis = sinopsis; }

    public Director getDirector() { return director; }
    public void setDirector(Director director) {
        if (director == null) {
            throw new DatosInvalidosException("El director no puede ser nulo.");
        }
        this.director = director;
    }

    /**
     * Devuelve una copia de la lista de actores para evitar modificaciones externas.
     */
    public List<Actor> getActores() {
        return new ArrayList<>(actores);
    }

    // ============================
    // EQUALS, HASHCODE Y TOSTRING
    // ============================
    /**
     * Dos películas son iguales si tienen el mismo ID.
     */
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Pelicula)) return false;
        Pelicula otra = (Pelicula) obj;
        return this.id.equals(otra.id);
    }

    @Override
    public int hashCode() {
        return id.hashCode();
    }

    @Override
    public String toString() {
        return String.format("'%s' (%d) - %s - Dir: %s",
                titulo, anio, genero, director.getNombreCompleto());
    }
}


