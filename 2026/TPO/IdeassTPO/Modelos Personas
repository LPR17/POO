package ar.edu.festivalcine.modelo.persona.empleado;

import ar.edu.festivalcine.excepciones.DatosInvalidosException;
import ar.edu.festivalcine.modelo.persona.Persona;
import java.time.LocalDate;

/**
 * Clase abstracta que representa a un empleado del festival.
 * Hereda de Persona y agrega atributos laborales comunes a todos los empleados.
 *
 * No se instancia directamente; se debe usar Acomodador u Organizador.
 */
public abstract class Empleado extends Persona {

    // ============================
    // ATRIBUTOS PROPIOS
    // ============================
    protected String legajo;
    protected double salario;
    protected LocalDate fechaContratacion;

    // ============================
    // CONSTRUCTOR
    // ============================
    public Empleado(String dni, String nombre, String apellido, LocalDate fechaNacimiento,
                    String legajo, double salario, LocalDate fechaContratacion) {
        super(dni, nombre, apellido, fechaNacimiento);

        if (legajo == null || legajo.isBlank()) {
            throw new DatosInvalidosException("El legajo no puede estar vacío.");
        }
        if (salario < 0) {
            throw new DatosInvalidosException("El salario no puede ser negativo.");
        }
        if (fechaContratacion == null || fechaContratacion.isAfter(LocalDate.now())) {
            throw new DatosInvalidosException("La fecha de contratación es inválida.");
        }

        this.legajo = legajo;
        this.salario = salario;
        this.fechaContratacion = fechaContratacion;
    }

    // ============================
    // GETTERS Y SETTERS
    // ============================
    public String getLegajo() { return legajo; }

    public double getSalario() { return salario; }
    public void setSalario(double salario) {
        if (salario < 0) {
            throw new DatosInvalidosException("El salario no puede ser negativo.");
        }
        this.salario = salario;
    }

    public LocalDate getFechaContratacion() { return fechaContratacion; }
}


