package ar.edu.festivalcine.modelo.sala;

import ar.edu.festivalcine.excepciones.ButacaOcupadaException;
import ar.edu.festivalcine.excepciones.DatosInvalidosException;
import ar.edu.festivalcine.excepciones.EntidadNoEncontradaException;
import ar.edu.festivalcine.modelo.festival.Pelicula;
import ar.edu.festivalcine.modelo.persona.empleado.Acomodador;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;

/**
 * Representa una función programada del festival.
 * Una función vincula una película con una sala en una fecha y hora específicas,
 * y gestiona su propio conjunto de butacas (independiente de otras funciones
 * en la misma sala).
 *
 * NOTA: La relación con Entrada se agregará cuando definamos esa clase.
 */
public class Funcion {

    // ============================
    // ATRIBUTOS
    // ============================
    private String id;
    private Pelicula pelicula;
    private Sala sala;
    private LocalDateTime fechaHora;
    private double precioBase;

    // Relaciones
    private List<Butaca> butacas;
    private List<Acomodador> acomodadores;

    // ============================
    // CONSTRUCTOR
    // ============================
    public Funcion(String id, Pelicula pelicula, Sala sala,
                   LocalDateTime fechaHora, double precioBase) {
        if (id == null || id.isBlank()) {
            throw new DatosInvalidosException("El ID de la función no puede estar vacío.");
        }
        if (pelicula == null) {
            throw new DatosInvalidosException("La función debe tener una película asociada.");
        }
        if (sala == null) {
            throw new DatosInvalidosException("La función debe tener una sala asignada.");
        }
        if (fechaHora == null) {
            throw new DatosInvalidosException("La fecha y hora de la función son obligatorias.");
        }
        if (precioBase < 0) {
            throw new DatosInvalidosException("El precio base no puede ser negativo.");
        }

        this.id = id;
        this.pelicula = pelicula;
        this.sala = sala;
        this.fechaHora = fechaHora;
        this.precioBase = precioBase;
        this.butacas = sala.generarButacas();   // genera el mapa de butacas para esta función
        this.acomodadores = new ArrayList<>();
    }

    // ============================
    // MÉTODOS DE NEGOCIO
    // ============================
    /**
     * Devuelve la fecha y hora de finalización de la función,
     * calculada a partir de la duración de la película.
     */
    public LocalDateTime getFechaHoraFin() {
        return fechaHora.plusMinutes(pelicula.getDuracionMinutos());
    }

    /**
     * Verifica si esta función se superpone temporalmente con otra
     * en la misma sala. Útil para validar al programar nuevas funciones.
     */
    public boolean seSuperponeCon(Funcion otra) {
        if (!this.sala.equals(otra.sala)) {
            return false;  // si son salas distintas, no hay superposición
        }
        // Hay superposición si los intervalos se cruzan
        return this.fechaHora.isBefore(otra.getFechaHoraFin())
                && otra.fechaHora.isBefore(this.getFechaHoraFin());
    }

    /**
     * Busca una butaca específica por su código (ej: "A5").
     * Lanza excepción si no existe.
     */
    public Butaca buscarButaca(String codigo) {
        for (Butaca b : butacas) {
            if (b.getCodigo().equalsIgnoreCase(codigo)) {
                return b;
            }
        }
        throw new EntidadNoEncontradaException(
                "No existe la butaca '" + codigo + "' en esta función.");
    }

    /**
     * Devuelve una lista solo con las butacas disponibles para vender.
     */
    public List<Butaca> getButacasDisponibles() {
        List<Butaca> disponibles = new ArrayList<>();
        for (Butaca b : butacas) {
            if (b.estaDisponible()) {
                disponibles.add(b);
            }
        }
        return disponibles;
    }

    /**
     * Cuenta cuántas butacas están ocupadas.
     */
    public int getCantidadOcupadas() {
        int contador = 0;
        for (Butaca b : butacas) {
            if (!b.estaDisponible()) {
                contador++;
            }
        }
        return contador;
    }

    /**
     * Devuelve el porcentaje de ocupación de la función (0-100).
     */
    public double getPorcentajeOcupacion() {
        if (butacas.isEmpty()) return 0.0;
        return (getCantidadOcupadas() * 100.0) / butacas.size();
    }

    /**
     * Asigna un acomodador a esta función.
     */
    public void asignarAcomodador(Acomodador acomodador) {
        if (acomodador == null) {
            throw new DatosInvalidosException("El acomodador no puede ser nulo.");
        }
        if (!acomodadores.contains(acomodador)) {
            acomodadores.add(acomodador);
        }
    }

    /**
     * Reserva una butaca específica (delega en el método de Butaca).
     * Lanza ButacaOcupadaException si ya estaba ocupada.
     */
    public void reservarButaca(String codigo) {
        Butaca butaca = buscarButaca(codigo);
        butaca.reservar();
    }

    // ============================
    // GETTERS Y SETTERS
    // ============================
    public String getId() { return id; }
    public Pelicula getPelicula() { return pelicula; }
    public Sala getSala() { return sala; }
    public LocalDateTime getFechaHora() { return fechaHora; }

    public double getPrecioBase() { return precioBase; }
    public void setPrecioBase(double precioBase) {
        if (precioBase < 0) {
            throw new DatosInvalidosException("El precio base no puede ser negativo.");
        }
        this.precioBase = precioBase;
    }

    public List<Butaca> getButacas() {
        return new ArrayList<>(butacas);
    }

    public List<Acomodador> getAcomodadores() {
        return new ArrayList<>(acomodadores);
    }

    // ============================
    // EQUALS, HASHCODE Y TOSTRING
    // ============================
    /**
     * Dos funciones son iguales si tienen el mismo ID.
     */
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Funcion)) return false;
        Funcion otra = (Funcion) obj;
        return this.id.equals(otra.id);
    }

    @Override
    public int hashCode() {
        return id.hashCode();
    }

    @Override
    public String toString() {
        return String.format("Función [%s] '%s' - %s - %s (%.0f%% ocupada)",
                id, pelicula.getTitulo(), sala.getNombre(), fechaHora, getPorcentajeOcupacion());
    }
}
