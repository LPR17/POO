package ar.edu.festivalcine.modelo.sala;

import ar.edu.festivalcine.excepciones.DatosInvalidosException;

import java.util.ArrayList;
import java.util.List;

/**
 * Representa una sala física del festival donde se proyectan películas.
 * La sala define su capacidad y la disposición de butacas (filas x columnas),
 * pero NO mantiene las butacas individuales.
 *
 * Cada Funcion programada en la sala genera su propio conjunto de butacas
 * para gestionar la ocupación de manera independiente.
 */
public class Sala {

    // ============================
    // ATRIBUTOS
    // ============================
    private String nombre;        // ej: "Sala 1 - Lumière"
    private int cantidadFilas;    // ej: 10 filas (A-J)
    private int butacasPorFila;   // ej: 12 butacas por fila

    // ============================
    // CONSTRUCTOR
    // ============================
    public Sala(String nombre, int cantidadFilas, int butacasPorFila) {
        if (nombre == null || nombre.isBlank()) {
            throw new DatosInvalidosException("El nombre de la sala no puede estar vacío.");
        }
        if (cantidadFilas <= 0) {
            throw new DatosInvalidosException("La cantidad de filas debe ser positiva.");
        }
        if (butacasPorFila <= 0) {
            throw new DatosInvalidosException("Las butacas por fila deben ser positivas.");
        }
        if (cantidadFilas > 26) {
            throw new DatosInvalidosException("La sala no puede tener más de 26 filas (A-Z).");
        }

        this.nombre = nombre;
        this.cantidadFilas = cantidadFilas;
        this.butacasPorFila = butacasPorFila;
    }

    // ============================
    // MÉTODOS DE NEGOCIO
    // ============================
    /**
     * Calcula la capacidad total de la sala.
     */
    public int getCapacidadTotal() {
        return cantidadFilas * butacasPorFila;
    }

    /**
     * Genera un nuevo conjunto de butacas para una función.
     * Las butacas se nombran con letras (A, B, C...) para las filas
     * y números (1, 2, 3...) para los asientos dentro de cada fila.
     *
     * Este método se invoca al crear una nueva Funcion en esta sala.
     */
    public List<Butaca> generarButacas() {
        List<Butaca> butacas = new ArrayList<>();

        for (int i = 0; i < cantidadFilas; i++) {
            // Convierte 0 -> "A", 1 -> "B", etc.
            String fila = String.valueOf((char) ('A' + i));

            for (int j = 1; j <= butacasPorFila; j++) {
                butacas.add(new Butaca(fila, j));
            }
        }

        return butacas;
    }

    // ============================
    // GETTERS Y SETTERS
    // ============================
    public String getNombre() { return nombre; }

    public int getCantidadFilas() { return cantidadFilas; }
    public int getButacasPorFila() { return butacasPorFila; }

    // ============================
    // EQUALS, HASHCODE Y TOSTRING
    // ============================
    /**
     * Dos salas son iguales si tienen el mismo nombre.
     */
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Sala)) return false;
        Sala otra = (Sala) obj;
        return this.nombre.equalsIgnoreCase(otra.nombre);
    }

    @Override
    public int hashCode() {
        return nombre.toLowerCase().hashCode();
    }

    @Override
    public String toString() {
        return String.format("Sala '%s' (%d x %d = %d butacas)",
                nombre, cantidadFilas, butacasPorFila, getCapacidadTotal());
    }
}

