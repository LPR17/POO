package ar.edu.festivalcine.modelo.sala;

import ar.edu.festivalcine.enums.EstadoButaca;
import ar.edu.festivalcine.excepciones.ButacaOcupadaException;
import ar.edu.festivalcine.excepciones.DatosInvalidosException;

/**
 * Representa una butaca dentro de una función específica.
 * Cada función tiene su propio conjunto de butacas, lo que permite
 * gestionar la ocupación de manera independiente entre funciones.
 */
public class Butaca {

    // ============================
    // ATRIBUTOS
    // ============================
    private String fila;          // ej: "A", "B", "C"
    private int numero;           // ej: 1, 2, 3
    private EstadoButaca estado;

    // ============================
    // CONSTRUCTOR
    // ============================
    public Butaca(String fila, int numero) {
        if (fila == null || fila.isBlank()) {
            throw new DatosInvalidosException("La fila de la butaca no puede estar vacía.");
        }
        if (numero <= 0) {
            throw new DatosInvalidosException("El número de butaca debe ser positivo.");
        }

        this.fila = fila.toUpperCase();
        this.numero = numero;
        this.estado = EstadoButaca.LIBRE;  // estado inicial
    }

    // ============================
    // MÉTODOS DE NEGOCIO
    // ============================
    /**
     * Indica si la butaca está disponible para ser reservada.
     */
    public boolean estaDisponible() {
        return estado == EstadoButaca.LIBRE;
    }

    /**
     * Reserva la butaca, cambiando su estado a OCUPADA.
     * Si la butaca ya está ocupada, lanza una excepción.
     */
    public void reservar() {
        if (!estaDisponible()) {
            throw new ButacaOcupadaException(
                    "La butaca " + getCodigo() + " ya está ocupada.");
        }
        this.estado = EstadoButaca.OCUPADA;
    }

    /**
     * Libera la butaca, dejándola disponible nuevamente.
     * Útil si se cancela una entrada.
     */
    public void liberar() {
        this.estado = EstadoButaca.LIBRE;
    }

    /**
     * Devuelve un código identificador de la butaca (ej: "A5").
     */
    public String getCodigo() {
        return fila + numero;
    }

    // ============================
    // GETTERS Y SETTERS
    // ============================
    public String getFila() { return fila; }
    public int getNumero() { return numero; }
    public EstadoButaca getEstado() { return estado; }

    // ============================
    // EQUALS, HASHCODE Y TOSTRING
    // ============================
    /**
     * Dos butacas son iguales si tienen la misma fila y número.
     * Atención: esto sólo tiene sentido dentro de una misma función,
     * ya que cada función tiene su propio conjunto de butacas.
     */
    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Butaca)) return false;
        Butaca otra = (Butaca) obj;
        return this.fila.equals(otra.fila) && this.numero == otra.numero;
    }

    @Override
    public int hashCode() {
        return fila.hashCode() * 31 + numero;
    }

    @Override
    public String toString() {
        return String.format("Butaca %s [%s]", getCodigo(), estado);
    }
}

